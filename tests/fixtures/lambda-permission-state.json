          "provider_name": "registry.terraform.io/hashicorp/aws",
          "values": {
            "arn": "arn:aws:s3:::demo-uploads-111111111111",
            "bucket": "demo-uploads-111111111111",
            "id": "demo-uploads-111111111111"
          }
        },
        {
          "address": "aws_lambda_permission.allow_s3",
          "mode": "managed",
          "type": "aws_lambda_permission",
          "name": "allow_s3",
