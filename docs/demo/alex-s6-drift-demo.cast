[9.642, "o", "\u001b[7mitest verify | head -2\u001b[27m\r\r\n\u001b[7mterraform plan -no-color | tail -3\u001b[27m\u001b[K\r\r\n\u001b[7mUUID=$(aws lambda list-event-source-mappings --function-name alex-planner --query 'EventSou\u001b[7mr\u001b[7mceMappings[0].UUID' --output text)\u001b[27m\u001b[K\r\r\n\u001b[7maws lambda update-event-source-mapping --uuid $UUID --no-enabled --query State --output tex\u001b[7mt\u001b[27m\u001b[K\r\r\n\u001b[7msleep 20\u001b[27m\u001b[K\r\r\n\u001b[7mterraform plan -no-color | tail -3\u001b[27m\u001b[K\r\r\n\u001b[7mitest verify | grep -E \"^[0-9]+ integration points|FAIL\"; echo \"exit ${pipestatus[1]}\"\u001b[27m\u001b[K\r\r\n\u001b[7maws lambda update-event-source-mapping --uuid $UUID --enabled --query State --output text\u001b[27m\u001b[K\r\r\n\u001b[7msleep 20\u001b[27m\u001b[K\r\r\n\u001b[7mitest verify | head -1\u001b[27m\u001b[K\r\r\n\u001b[7mexit\u001b[27m\u001b[K"]
