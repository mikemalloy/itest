# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/
.pytest_cache/
.venv/
venv/
env/

# ITest artifacts. In a real project you commit .itest/manifest.yaml and your
# itest_tests/; in *this* repo they are throwaway output from running the demo
# quickstart, so they are ignored here.
.itest/
/itest_tests/
itest-results.xml

# Answers recorded by the itest-implementer skill. May name accounts,
# profiles, regions, and local paths, so consumers should ignore it too —
# it is machine-local configuration, not shared project state.
.itest/skill-answers.yaml

# The environment binding: which environment THIS checkout is pointed at.
# Machine-local state like skill-answers.yaml above — the policy
# (.itest/environments.yaml) is committed and code-reviewed, the binding is not.
.itest/environment

# Active-tier test credentials. The token lives here as NAME=<token> and is read
# only by name; it must never be committed. A raw secret would otherwise be one
# `git add` away from the history.
.env
.itest/.env

# Terraform working artifacts
.terraform/
*.tfstate
*.tfstate.*
tfplan
