# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/
.pytest_cache/
.venv/
venv/
env/

# ITest artifacts. In a real project you commit .itest/manifest.yaml and your
# itest_tests/; in *this* repo they are throwaway output from running the demo
# quickstart, so they are ignored here.
.itest/
/itest_tests/
itest-results.xml

# Answers recorded by the itest-implementer skill. May name accounts,
# profiles, regions, and local paths, so consumers should ignore it too —
# it is machine-local configuration, not shared project state.
.itest/skill-answers.yaml

# Terraform working artifacts
.terraform/
*.tfstate
*.tfstate.*
tfplan
